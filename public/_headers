# Always revalidate HTML & Service Worker so updates are immediate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/registerSW.js
  Cache-Control: public, max-age=0, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate

# Hashed JS/CSS in /assets/ can be cached immutably
/assets/index-*.js
  Cache-Control: public, max-age=31536000, immutable

/assets/index-*.css
  Cache-Control: public, max-age=31536000, immutable

# Images use revalidation to prevent stuck stale icons
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
